# 复制本文件为 .env，然后填入你在阿里云百炼申请的真实 API Key
# 注意：.env 含密钥，不要提交到 Git（已在 .gitignore 中排除）

# 阿里云百炼的 API Key（sk- 开头）
DASHSCOPE_API_KEY=sk-todo

# 模型名：填你账号有权限/有免费额度的模型
# 参考：qwen-plus / qwen-turbo / qwen-flash / qwen-max
#       qwen3.8-flash / qwen3.7-plus / qwen4-max（以你控制台实际可用为准）
QWEN_MODEL=qwen-flash

# 百炼 OpenAI 兼容模式端点（华北2-北京，一般无需改动）
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
